# Portable defaults. Existing user configuration takes precedence.
[alias]
    st = status --short --branch
    sw = switch
    br = branch
    ci = commit
    unstage = restore --staged
    last = log -1 --stat
    lg = log --graph --decorate --oneline --all
[init]
    defaultBranch = master
[pull]
    ff = only
[fetch]
    prune = true
[color]
    ui = auto
[diff]
    algorithm = histogram
    colorMoved = default
[merge]
    conflictStyle = diff3
[core]
    pager = "\"${XDG_CONFIG_HOME:-$HOME/.config}/git-setup/pager.sh\""
